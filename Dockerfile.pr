ARG ECR_ACCOUNT_ID
FROM ${ECR_ACCOUNT_ID}.dkr.ecr.ca-central-1.amazonaws.com/ecr-public/awsguru/aws-lambda-adapter:1.0.0@sha256:b4da35991627bdac98a81c377d0cc28e6989687359576dfda9f0b64be835d648 AS lambda-adapter-source

# User portal that runs as a Lambda function.  It is used to create
# Lambda function review environments for each PR.
FROM node:26-alpine@sha256:20c29f6abefc3dffbdcae5677e4ee5dd0c45073a24ff6f5a7f25010b825f0a7b AS build

ARG GIT_SHA

ENV NODE_ENV=production

ENV NEXT_OUTPUT_STANDALONE=true
ENV CI=true
ENV GIT_SHA=$GIT_SHA
ENV PORT=3002

COPY . /src
WORKDIR /src

RUN npm install --global corepack@0.36.0 && corepack enable
RUN pnpm install
RUN pnpm build

FROM node:26-alpine@sha256:20c29f6abefc3dffbdcae5677e4ee5dd0c45073a24ff6f5a7f25010b825f0a7b AS final
LABEL maintainer="-"

ARG GIT_SHA

ENV NODE_ENV=production
ENV GIT_SHA=$GIT_SHA
ENV AWS_LWA_ASYNC_INIT=true
ENV AWS_LWA_ENABLE_COMPRESSION=true
ENV AWS_LWA_READINESS_CHECK_PATH=/healthy
ENV HOSTNAME=localhost
ENV PORT=3002
ENV PR_REVIEW=true

WORKDIR /src

COPY --from=build /src/.next/standalone ./
COPY --from=build /src/.next/static ./.next/static

COPY public ./public
COPY scripts/pr-review-entrypoint.sh ./entrypoint.sh

# Required by the entrypoint.sh to load the SSM ParameterStore environment variables
RUN apk update && apk add --no-cache aws-cli

# Lambda web adapter: https://github.com/awslabs/aws-lambda-web-adapter
COPY --from=lambda-adapter-source /lambda-adapter /opt/extensions/lambda-adapter
RUN ln -s /tmp ./.next/cache

EXPOSE 3002

ENTRYPOINT ["./entrypoint.sh"]