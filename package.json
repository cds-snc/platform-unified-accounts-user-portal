{
  "name": "platform-unified-accounts-user-portal",
  "version": "0.2.0",
  "private": true,
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./styles/app.css",
    "trailingComma": "es5",
    "tabWidth": 2,
    "printWidth": 100,
    "useTabs": false,
    "semi": true,
    "singleQuote": false
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint",
      "prettier --check"
    ],
    "*.{json,md}": [
      "prettier --check"
    ]
  },
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:verbose": "DEBUG=true next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "upgrade": "next upgrade",
    "prepare": "husky",
    "knip": "knip",
    "lint-staged": "lint-staged",
    "util:flow": "tsx ./dev_utils/oidc_flows/start.ts"
  },
  "dependencies": {
    "@gcforms/connectors": "^2.2.20",
    "@gcforms/core": "2.2.27",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@zitadel/client": "^1.3.1",
    "@zitadel/proto": "^1.3.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "copy-to-clipboard": "^4.0.0",
    "i18next": "^26.0.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-resources-to-backend": "^1.2.1",
    "moment": "^2.30.1",
    "next": "16.3.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.0",
    "react-toastify": "^11.0.5",
    "uuid": "^14.0.0",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "@connectrpc/connect": "^2.1.1",
    "@gcds-core/tokens": "^1.0.0",
    "@gcforms/types": "1.0.38",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "clsx": "^2.1.1",
    "cssnano": "^8.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.0.0",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.0",
    "knip": "^6.13.1",
    "lint-staged": "^17.0.0",
    "openid-client": "^6.8.7",
    "postcss": "^8.5.14",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sass": "^1.97.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@11.22.0"
}
